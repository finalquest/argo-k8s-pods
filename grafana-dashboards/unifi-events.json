      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (count_over_time({job=\"unifi\"} |= \"UniFi Protect\" | regexp \"UniFi Protect\\\\|[^|]*\\\\|[^|]*\\\\|(?P<event>[^|]*)\" [$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Eventos",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "Value.*",
            "renamePattern": "Eventos"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "event": "Detección"
            }
          }
        }
      ]
